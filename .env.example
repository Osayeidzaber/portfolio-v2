# Copy to .env.local for development, and add the same keys in Vercel → Settings → Environment Variables.
# Nothing here is ever sent to the browser (no NEXT_PUBLIC_ prefix except the site URL).

# Canonical URL, used for metadata, sitemap and Open Graph.
# Bare domains such as zaber.tech are normalized to https://zaber.tech.
NEXT_PUBLIC_SITE_URL=https://zaber.tech

# --- GitHub data (read-only) ---
GITHUB_USERNAME=Osayeidzaber
# Optional but recommended: a fine-grained token with no extra permissions (public data only).
# Raises the API rate limit and enables the real contribution calendar in the Ledger.
GITHUB_TOKEN=

# --- Admin publishing (write) ---
# The repository this site is deployed from, as owner/name.
GITHUB_CONTENT_REPO=
GITHUB_CONTENT_BRANCH=main
# Fine-grained personal access token: Repository access → only GITHUB_CONTENT_REPO,
# Permissions → Contents: Read and write. Nothing else.
GITHUB_CONTENT_TOKEN=

# --- Admin login ---
# Run `pnpm hash-password` and paste both lines it prints.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# --- Cache refresh ---
# Secret for the GitHub webhook (Settings → Webhooks → Secret).
GITHUB_WEBHOOK_SECRET=
# Optional: bearer token for POST /api/revalidate.
REVALIDATE_SECRET=

# --- OZ Studio invoices (separate private storage; never use the public site repo) ---
# Create a private repository with an initial commit. Invoice storage refuses public repos.
STUDIO_DATA_REPO=Osayeidzaber/oz-studio-invoices
STUDIO_DATA_BRANCH=main
# Fine-grained token with Contents: read and write on the private studio repository only.
STUDIO_GITHUB_TOKEN=
# Resend API key, and a bare email address on a Resend-verified sending domain.
RESEND_API_KEY=
STUDIO_EMAIL_FROM=invoices@zaber.tech
